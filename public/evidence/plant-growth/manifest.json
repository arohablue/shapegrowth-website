  "lam": 30.0,
  "w": 0.2,
  "n_points": 3000,
  "rigid_prealignment": true,
  "soil_label_removed": 0,
  "shared_centre_and_scale": true
 },
 "interval_note": "All specimens use the same pair, 03-24 to 03-25, one day apart. It is the only labelled consecutive-day pair in Pheno4D.",
 "caveats": [
  "Displacement is the estimated motion between two scans. It includes leaf bending, drooping, rotation and registration error, not only growth.",
  "det J describes local volumetric deformation of an estimated map. A plant's leaves are thin surfaces, so it is a cautious proxy and should be read qualitatively — where tissue expands, not by how much.",
  "Non-positive det J means the estimated map folds there. Those points carry no readable expansion or compression and are shown as invalid rather than clipped.",
  "Point correspondence is estimated by the registration, not observed. The scans are independent samplings of the plant and share no ground-truth point identity."
 ],
 "coverage": {
  "plants_in_study": 14,
  "plants_with_point_data": 5,
  "note": "14 plants were processed; 5 have point-level arrays available here. The rest exist only as summary statistics and rendered figures, so they are omitted rather than shown without data."
 },
