# ─────────────────────────────────────────────────────────────────────────────
# RECONSTRUCTION ASSETS
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and point at your files. Vite inlines these at build
# time, so restart the dev server after changing anything here.
#
# Both assets are optional and independent. Unset means "not supplied yet" —
# the scene falls back to the placeholder specimen, it is not an error.
#
# Files under `public/` are served from the web root: `public/models/scan.ply`
# is `/models/scan.ply`. Absolute URLs to a CDN work too.

# ── Point cloud (PLY) ────────────────────────────────────────────────────────
VITE_POINTCLOUD_URL=/models/scan.ply

# Capture rigs and CloudCompare exports are usually Z-up; three is Y-up.
# y | z          (default: y)
VITE_POINTCLOUD_UP_AXIS=z

# The scan is uniformly scaled until its bounding box is this tall, so framing
# is independent of whether the file is in millimetres or metres.
# (default: 3.2 — matches the volume the camera spline is tuned for)
VITE_POINTCLOUD_TARGET_HEIGHT=3.2

# bounds = centre the bounding box on the origin
# base   = plant the lowest point at y=0        (default: bounds)
VITE_POINTCLOUD_ANCHOR=bounds

# Applied after anchoring, in world units.       (default: 0)
VITE_POINTCLOUD_Y_OFFSET=0

# Yaw in radians, applied after the up-axis fix. Frames the best side of the
# scan toward the camera.                        (default: 0)
VITE_POINTCLOUD_YAW=0

# true | false. Unset = auto: use the PLY's vertex colours when it has them,
# fall back to the palette tint when it does not.
# VITE_POINTCLOUD_VERTEX_COLORS=true

# Ceiling on uploaded points. Decimation is a deterministic stride, so the same
# file always yields the same cloud. Unset keeps every point.
# VITE_POINTCLOUD_MAX_POINTS=1500000

# ── Mesh (GLB / GLTF) ────────────────────────────────────────────────────────
VITE_MESH_URL=/models/reconstruction.glb

VITE_MESH_UP_AXIS=y
VITE_MESH_TARGET_HEIGHT=3.2
VITE_MESH_ANCHOR=bounds
VITE_MESH_Y_OFFSET=0
VITE_MESH_YAW=0

# Only needed if the GLB is Draco-compressed. Point at a directory containing
# the decoder — copy it from `node_modules/three/examples/jsm/libs/draco/` into
# `public/` so it is self-hosted rather than fetched from a CDN.
# VITE_MESH_DRACO_PATH=/draco/
