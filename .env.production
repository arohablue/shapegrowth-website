# Committed so CI builds have asset URLs.
# Real sunflower reconstruction from data/colmap-sunflower, built by
# scripts/build-reconstruction-assets.mjs. Height/offset are DERIVED by that
# script — do not hand-edit; rerun the script if the source scan changes.

VITE_POINTCLOUD_URL=/models/sunflower-cloud.ply
VITE_POINTCLOUD_UP_AXIS=y
VITE_POINTCLOUD_TARGET_HEIGHT=3.2
VITE_POINTCLOUD_ANCHOR=bounds

VITE_MESH_URL=/models/sunflower-mesh.glb
VITE_MESH_UP_AXIS=y
VITE_MESH_TARGET_HEIGHT=3.2523
VITE_MESH_Y_OFFSET=-0.0156
VITE_MESH_ANCHOR=bounds
